<Window x:Class="Check_IT.ProzorroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prozorro" Height="520" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource AppWindow}">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Заголовок -->
		<StackPanel Grid.Row="0" Margin="0,0,0,12">
			<TextBlock x:Name="HeaderTitle"
                       FontSize="24"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,4"/>
			<TextBlock x:Name="HeaderSubtitle"
                       FontSize="14"
                       Opacity="0.85"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
		</StackPanel>

		<!-- Ввід ID + кнопка -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
			<TextBox x:Name="TenderIdTextBox"
                     Width="420"
                     Height="36"
                     FontSize="14"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Left"
                     BorderThickness="2"
                     BorderBrush="#0efc3d"/>

			<Button x:Name="AnalyzeButton"
                    Width="140"
                    Height="36"
                    Click="AnalyzeButton_Click"
                    Style="{StaticResource PrimaryButton}">
				<TextBlock x:Name="AnalyzeButtonText"
                           Text="Аналізувати"
                           FontSize="14"
                           FontWeight="SemiBold"/>
			</Button>
		</StackPanel>

		<!-- Інформація / статус -->
		<TextBlock Grid.Row="2"
                   x:Name="InfoText"
                   FontSize="12"
                   Margin="0,0,0,8"
                   Opacity="0.85"
                   TextWrapping="Wrap"/>

		<!-- Таблиця результатів -->
		<DataGrid Grid.Row="3"
                  x:Name="ResultsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  ItemsSource="{Binding ProzorroItems}">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Назва товару"
                                    Binding="{Binding Name}"
                                    Width="*"/>
				<DataGridTextColumn Header="Ціна з тендеру, грн"
                                    Binding="{Binding Price}"
                                    Width="200"/>
				<DataGridTextColumn Header="Ціна з Rozetka, грн"
                                    Binding="{Binding RozetkaPrice}"
                                    Width="200"/>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</Window>
