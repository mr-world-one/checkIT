<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Check_IT.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="600" Width="900" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Center">
                <TextBlock x:Name="HeaderText" FontSize="32" FontWeight="Bold" Foreground="#333" Margin="0,8"/>
                <TextBlock x:Name="IntroText" FontSize="16" FontWeight="600" Foreground="#555" Margin="0,8,0,20" TextWrapping="Wrap"/>

                <Border Background="#FFFFFF" Padding="20" CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="15" Foreground="#444" Margin="0,0,0,12"/>

                        <TextBlock x:Name="FeaturesHeader" FontSize="20" FontWeight="Bold" Foreground="#f00808" Margin="0,8" />
                        <StackPanel Margin="8,6,0,12">
                            <TextBlock x:Name="Feature1" TextWrapping="Wrap" FontSize="15" Foreground="#444" Margin="0,4" />
                            <TextBlock x:Name="Feature2" TextWrapping="Wrap" FontSize="15" Foreground="#444" Margin="0,4" />
                            <TextBlock x:Name="Feature3" TextWrapping="Wrap" FontSize="15" Foreground="#444" Margin="0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#f8f8f8" Padding="16" CornerRadius="8" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ContactsHeader" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,6" />
                        <TextBlock x:Name="Contact1" FontSize="15" FontWeight="600" Foreground="#555" Margin="0,6" />
                        <TextBlock x:Name="Contact2" FontSize="15" FontWeight="600" Foreground="#555" Margin="0,6" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Width="100" Click="Close_Click" Content="Close"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>