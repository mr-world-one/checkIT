<Application x:Class="Check_IT.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Основні кольори -->
        <SolidColorBrush x:Key="PrimaryGreenStart" Color="#27ac0f"/>
        <SolidColorBrush x:Key="PrimaryGreenEnd" Color="#41ec22"/>
        <SolidColorBrush x:Key="AccentRed" Color="#f00808"/>
        <SolidColorBrush x:Key="TextDark" Color="#1a1a1a"/>
        <SolidColorBrush x:Key="TextLight" Color="#555555"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#FFF2F2F2"/>

        <!-- Анімований градієнт (при необхідності перемістіть до MainWindow resources) -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#27ac0f" Offset="0"/>
            <GradientStop Color="#41ec22" Offset="1"/>
        </LinearGradientBrush>

        <!-- Шрифти: use system fallbacks to avoid missing file errors -->
        <FontFamily x:Key="RubikFont">Segoe UI</FontFamily>
        <FontFamily x:Key="RalewayFont">Segoe UI</FontFamily>

        <!-- Стиль вікон -->
        <Style TargetType="Window" x:Key="AppWindow">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="FontFamily" Value="{StaticResource RubikFont}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#999999" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared base style for input controls to be used by TextBox and PasswordBox -->
        <Style x:Key="InputBase" TargetType="Control">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#999999" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопок -->
        <Style TargetType="Button" x:Key="HeaderButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2ecc71"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#27ae60"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль текстових полів (TextBox не має CornerRadius, використовуйте ControlTemplate для кастомізації) -->
        <Style TargetType="TextBox" x:Key="InputTextBox" BasedOn="{StaticResource InputBase}">
            <!-- additional TextBox-specific setters could go here -->
        </Style>

        <Style TargetType="PasswordBox" x:Key="InputPasswordBox" BasedOn="{StaticResource InputBase}">
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Стиль статусбару -->
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <!-- Глобальний стиль тексту -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RubikFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Application.Resources>
</Application>